# Variáveis de Ambiente do Firebase
# Copie estas chaves e valores para as configurações de "Environment Variables" do seu projeto na Vercel.
# NÃO suba este arquivo para o seu repositório Git.

NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyA_...Your_Key_Here..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:your-sender-id:web:your-app-id"
